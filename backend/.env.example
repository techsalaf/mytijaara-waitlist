APP_NAME="MyTijaara API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mytijaara
DB_USERNAME=mytijaara
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Scheduled tasks (shared hosting / cPanel cron)
# ---------------------------------------------------------------------------
# Shared secret for GET|POST /api/v1/cron/run. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Leave EMPTY to disable the HTTP trigger entirely — the endpoint then answers
# 503 to everything. The Artisan/CLI cron entry does not need this at all.
# Never expose this value to the browser; it is server-side only.
CRON_TOKEN=

# ---------------------------------------------------------------------------
# Unverified-waitlister email reminders
# ---------------------------------------------------------------------------
# Master switch. false stops all reminder sends without touching cron.
VERIFICATION_REMINDERS_ENABLED=true
# Days between nudges for one address, measured from the last reminder, or from
# signup if none has been sent yet.
VERIFICATION_REMINDER_INTERVAL_DAYS=3
# Hard cap per address. 5 x 3 days = the address is left alone after ~15 days.
# 0 means never stop (not recommended: it damages sender reputation).
VERIFICATION_REMINDER_MAX_PER_ENTRY=5
# Most reminders one cron invocation will send. Keeps the run well inside a
# shared-hosting PHP time limit.
VERIFICATION_REMINDER_BATCH_SIZE=50
# Rows read per database round trip inside a run.
VERIFICATION_REMINDER_CHUNK_SIZE=25
